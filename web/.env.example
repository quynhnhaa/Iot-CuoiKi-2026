# Sao chep thanh web/.env. File .env da nam trong .gitignore.
# Moi bien doc boi backend deu co tien to WEB_.

# BAT BUOC. Khoa ky JWT; thieu bien nay backend khong khoi dong.
# Sinh mot khoa moi:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SECRET_KEY=

# Chuoi ket noi co so du lieu. Mac dinh la SQLite trong web/backend/.
# Vi du PostgreSQL: postgresql+psycopg://user:pass@localhost:5432/quanly
WEB_DATABASE_URL=sqlite:///./quanly.db

# Cac origin duoc phep goi API, cach nhau bang dau phay.
WEB_CORS_ORIGINS=http://localhost:5173

# --- Xac thuc hai lop ---

# Doi song access token va token trung gian cua buoc nhap ma (phut).
WEB_ACCESS_TOKEN_MINUTES=30
WEB_MFA_TOKEN_MINUTES=5

# Ten hien trong ung dung sinh ma (Google Authenticator, Aegis...).
WEB_TOTP_ISSUER=May dem vien thuoc

# So buoc 30 giay chap nhan lech dong ho moi phia. 1 = +/- 30 giay.
WEB_TOTP_VALID_WINDOW=1

# Khoa tam tai khoan sau bao nhieu lan sai, va khoa trong bao lau (phut).
WEB_MAX_FAILED_ATTEMPTS=5
WEB_LOCKOUT_MINUTES=15

# So ma du phong phat ra khi ghi danh.
WEB_RECOVERY_CODE_COUNT=8

# Chi phi bam mat khau bcrypt. Khong ha duoi 12 o ban chay that.
WEB_BCRYPT_ROUNDS=12

# --- ThingsBoard ---

# Tat mac dinh. Backend chay binh thuong khi khong co ThingsBoard.
WEB_THINGSBOARD_ENABLED=false

# Dia chi ThingsBoard va access token cua thiet bi se mang telemetry cua web.
# WEB_THINGSBOARD_BASE_URL=http://localhost:8080
# WEB_THINGSBOARD_DEVICE_TOKEN=
WEB_THINGSBOARD_TIMEOUT_SECONDS=3

# Bi mat cho kenh nhan lenh start/pause/stop tu dashboard.
# De TRONG nghia la TAT HAN endpoint /api/thingsboard/commands.
# Sinh mot bi mat moi:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEB_THINGSBOARD_COMMAND_SECRET=

# --- Duong dan sang nhanh AI trong cung repo ---
# WEB_MODEL_DIR=../model
# WEB_PIPELINE_RUNS_DIR=../model/runs/pipeline
